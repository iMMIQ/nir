  "locales": {
    "zh-Hans": {
      "speaker.aki": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "秋"
          }
        ]
      },
      "intro": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "末班电车刚刚离开。雨把站前的灯光，揉成一封迟迟没有寄出的信。"
          }
        ]
      },
      "arrival": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "你还是来了。"
          }
        ]
      },
      "letter": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "这封信，我写了很久。"
          },
          {
            "type": "gate",
            "id": "bell"
          },
          {
            "type": "text",
            "id": "tail",
            "text": "你愿意收下吗？"
          }
        ]
      },
      "after_gate": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "远处的钟响了。秋把信封放进你的掌心。"
          }
        ]
      },
      "question": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "雨好像小了一些。接下来……你想去哪里？"
          }
        ]
      },
      "walk": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "沿着河边，一起走回去"
          }
        ]
      },
      "stay": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "留在车站，读完这封信"
          }
        ]
      },
      "walk_line": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "那就慢慢走吧。今天的路，我想和你一起走完。"
          }
        ]
      },
      "walk_end": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "雨停了。没有说出口的话，也终于有了归处。"
          }
        ]
      },
      "stay_line": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "那我就在这里，陪你读到最后。"
          }
        ]
      },
      "stay_end": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "纸上的字迹有些模糊。可你知道，这一次，你不会再错过。"
          }
        ]
      }
    },
    "en": {
      "speaker.aki": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "Aki"
          }
        ]
      },
      "intro": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "The last train has gone. Rain folds the station lights into a letter that was never sent."
          }
        ]
      },
      "arrival": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "You came after all."
          }
        ]
      },
      "letter": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "I took a long time to write this letter."
          },
          {
            "type": "gate",
            "id": "bell"
          },
          {
            "type": "text",
            "id": "tail",
            "text": "Will you take it?"
          }
        ]
      },
      "after_gate": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "A distant bell rings. Aki places the envelope in your hand."
          }
        ]
      },
      "question": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "The rain is letting up. Where would you like to go?"
          }
        ]
      },
      "walk": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "Walk home together along the river"
          }
        ]
      },
      "stay": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "Stay at the station and read the letter"
          }
        ]
      },
      "walk_line": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "Let’s take our time. Tonight, I want to walk the whole way with you."
          }
        ]
      },
      "walk_end": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "The rain stops. At last, the words left unspoken have found a home."
          }
        ]
      },
      "stay_line": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "Then I’ll stay here with you until the last word."
          }
        ]
      },
      "stay_end": {
        "revision": 1,
        "spans": [
          {
            "type": "text",
            "id": "body",
            "text": "The ink is a little blurred. But this time, you know you won’t miss what it means."
          }
        ]
      }
    }
