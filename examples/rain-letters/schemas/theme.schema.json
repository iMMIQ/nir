{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThemeManifest",
  "type": "object",
  "properties": {
    "base": {
      "type": "string"
    },
    "choice": {
      "$ref": "#/$defs/ChoiceProps",
      "default": {
        "item_height": 58.0,
        "width": 520.0
      }
    },
    "dialogue": {
      "$ref": "#/$defs/DialogueProps",
      "default": {
        "font_size": 23.0,
        "height": 220.0,
        "padding": 24.0
      }
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "slots": {
      "$ref": "#/$defs/ThemeSlots",
      "default": {
        "choice.main": "builtin.choice",
        "dialogue.main": "builtin.dialogue"
      }
    },
    "tokens": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "base",
    "tokens"
  ],
  "$defs": {
    "ChoiceComponent": {
      "type": "string",
      "enum": [
        "builtin.choice",
        "builtin.choice.compact"
      ]
    },
    "ChoiceProps": {
      "type": "object",
      "properties": {
        "item_height": {
          "type": "number",
          "format": "float",
          "default": 58.0
        },
        "width": {
          "type": "number",
          "format": "float",
          "default": 520.0
        }
      },
      "additionalProperties": false
    },
    "DialogueComponent": {
      "type": "string",
      "enum": [
        "builtin.dialogue",
        "builtin.dialogue.top"
      ]
    },
    "DialogueProps": {
      "type": "object",
      "properties": {
        "font_size": {
          "type": "number",
          "format": "float",
          "default": 23.0
        },
        "height": {
          "type": "number",
          "format": "float",
          "default": 220.0
        },
        "padding": {
          "type": "number",
          "format": "float",
          "default": 24.0
        }
      },
      "additionalProperties": false
    },
    "ThemeSlots": {
      "description": "Closed component registry implemented by the locked player SDK. Components\nonly project state; their actions and focus semantics remain player-owned.",
      "type": "object",
      "properties": {
        "choice.main": {
          "$ref": "#/$defs/ChoiceComponent",
          "default": "builtin.choice"
        },
        "dialogue.main": {
          "$ref": "#/$defs/DialogueComponent",
          "default": "builtin.dialogue"
        }
      },
      "additionalProperties": false
    }
  }
}