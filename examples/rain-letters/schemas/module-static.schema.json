{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleStatic",
  "type": "object",
  "properties": {
    "activation_recipes": {
      "description": "Cue asset recipes contain only cue audio and images from presented\nscenes. Font plans are separate catalog consumers.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "default": {}
    },
    "choices": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Choice"
      },
      "default": {}
    },
    "cues": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Cue"
      },
      "default": {}
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "module": {
      "type": "string"
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Node"
        }
      },
      "default": {}
    },
    "text_contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TextContract"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "module"
  ],
  "$defs": {
    "AudioBus": {
      "type": "string",
      "enum": [
        "bgm",
        "voice",
        "sfx"
      ]
    },
    "BinaryOp": {
      "type": "string",
      "enum": [
        "add",
        "sub",
        "mul",
        "div",
        "rem",
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "and",
        "or",
        "concat"
      ]
    },
    "CancelPolicy": {
      "type": "string",
      "enum": [
        "commit_current",
        "settle_end",
        "restore_base"
      ]
    },
    "Choice": {
      "type": "object",
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          }
        },
        "timeout_us": {
          "anyOf": [
            {
              "$ref": "#/$defs/Micros"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "options"
      ]
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "visible": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ]
    },
    "Cue": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectDef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "effects"
      ]
    },
    "Easing": {
      "type": "string",
      "enum": [
        "linear",
        "smooth"
      ]
    },
    "Effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "duration_us": {
              "$ref": "#/$defs/Micros",
              "default": "0"
            },
            "scene": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "stage_present"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "scene"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cancel": {
              "$ref": "#/$defs/CancelPolicy",
              "default": "commit_current"
            },
            "duration_us": {
              "$ref": "#/$defs/Micros"
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "default": "linear"
            },
            "finish": {
              "$ref": "#/$defs/FinishPolicy",
              "default": "commit_end"
            },
            "node": {
              "type": "string"
            },
            "property": {
              "$ref": "#/$defs/Property"
            },
            "replace": {
              "type": "boolean",
              "default": false
            },
            "to": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "clip"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "node",
            "property",
            "to",
            "duration_us"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reveal_us": {
              "$ref": "#/$defs/Micros"
            },
            "speaker": {
              "type": "string",
              "default": ""
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "dialogue"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "reveal_us"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "bus": {
              "$ref": "#/$defs/AudioBus"
            },
            "looped": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string",
              "const": "audio"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "asset",
            "bus"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration_us": {
              "$ref": "#/$defs/Micros"
            },
            "type": {
              "type": "string",
              "const": "delay"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "duration_us"
          ]
        }
      ]
    },
    "EffectDef": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "effect"
      ]
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "const"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "var"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "left": {
              "$ref": "#/$defs/Expr"
            },
            "op": {
              "$ref": "#/$defs/BinaryOp"
            },
            "right": {
              "$ref": "#/$defs/Expr"
            },
            "type": {
              "type": "string",
              "const": "binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/Expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "FinishPolicy": {
      "type": "string",
      "enum": [
        "commit_end",
        "remove_effect"
      ]
    },
    "Micros": {
      "type": "string"
    },
    "Node": {
      "type": "object",
      "properties": {
        "asset": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "clip": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "color": {
          "type": "array",
          "default": [
            1.0,
            1.0,
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "height": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "order": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scale": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "width": {
          "type": "number",
          "format": "float"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "Property": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "scale",
        "opacity"
      ]
    },
    "Scope": {
      "type": "string",
      "enum": [
        "session",
        "frame",
        "scene",
        "interaction"
      ]
    },
    "TextContract": {
      "type": "object",
      "properties": {
        "contract_digest": {
          "type": "string"
        },
        "contract_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "meaning_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "default": {}
        },
        "source_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "source_revision",
        "contract_revision",
        "meaning_revision",
        "contract_digest"
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "i32"
            },
            "value": {
              "type": "integer",
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "ValueType": {
      "type": "string",
      "enum": [
        "bool",
        "i32",
        "string"
      ]
    }
  }
}