{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map_of_AuthorTextContract",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/AuthorTextContract"
  },
  "$defs": {
    "AuthorTextContract": {
      "type": "object",
      "properties": {
        "contract_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "meaning_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ValueType"
          },
          "default": {}
        },
        "source_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "source_revision",
        "contract_revision",
        "meaning_revision"
      ]
    },
    "ValueType": {
      "type": "string",
      "enum": [
        "bool",
        "i32",
        "string"
      ]
    }
  }
}