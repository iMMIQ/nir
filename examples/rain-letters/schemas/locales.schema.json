{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocaleManifest",
  "type": "object",
  "properties": {
    "default_text": {
      "type": "string"
    },
    "default_ui": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "default_ui",
    "default_text",
    "ui",
    "text"
  ]
}