{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssetSource"
      }
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "assets"
  ],
  "$defs": {
    "AssetKind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "font"
      ]
    },
    "AssetSource": {
      "type": "object",
      "properties": {
        "expected_size": {
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontRecipe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "rights": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "rights"
      ]
    },
    "FontMode": {
      "type": "string",
      "enum": [
        "subset",
        "full"
      ]
    },
    "FontRecipe": {
      "type": "object",
      "properties": {
        "extra_characters": {
          "type": "string",
          "default": ""
        },
        "face_index": {
          "description": "Zero-based face in an OTF/TTF/TTC source. Output always contains one face.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "license": {
          "description": "Relative to the asset catalog, with the same containment rules as source.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/FontMode"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "license"
      ]
    }
  }
}