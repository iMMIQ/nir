{
  "speaker.aki": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "秋"
      }
    ]
  },
  "intro": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "末班电车刚刚离开。雨把站前的灯光，揉成一封迟迟没有寄出的信。"
      }
    ]
  },
  "arrival": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "你还是来了。"
      }
    ]
  },
  "letter": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "这封信，我写了很久。"
      },
      {
        "type": "gate",
        "id": "bell"
      },
      {
        "type": "text",
        "id": "tail",
        "text": "你愿意收下吗？"
      }
    ]
  },
  "after_gate": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "远处的钟响了。秋把信封放进你的掌心。"
      }
    ]
  },
  "question": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "雨好像小了一些。接下来……你想去哪里？"
      }
    ]
  },
  "walk": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "沿着河边，一起走回去"
      }
    ]
  },
  "stay": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "留在车站，读完这封信"
      }
    ]
  },
  "walk_line": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "那就慢慢走吧。今天的路，我想和你一起走完。"
      }
    ]
  },
  "walk_end": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "雨停了。没有说出口的话，也终于有了归处。"
      }
    ]
  },
  "stay_line": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "那我就在这里，陪你读到最后。"
      }
    ]
  },
  "stay_end": {
    "revision": 1,
    "spans": [
      {
        "type": "text",
        "id": "body",
        "text": "纸上的字迹有些模糊。可你知道，这一次，你不会再错过。"
      }
    ]
  }
}
