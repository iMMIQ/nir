{
  "name": "nir-browser-tests",
  "version": "0.1.1",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "check:js": "bun build --target=browser --format=esm --outdir target/tmp/js-check crates/nir-platform-web/host.js crates/nir-platform-web/runtime-worker.js crates/nir-platform-web/asset-worker.js apps/player-web/host/bootstrap.js tools/novelc/src/preview-client.js",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:backends": "NIR_PW_SUITE=backends playwright test",
    "test:host": "bun test ./tests/host",
    "test:network-transfer": "node scripts/verify_network_transfer.mjs",
    "test:nir-next": "NIR_PW_SUITE=nir-next playwright test",
    "test:performance": "node scripts/run-performance.mjs ci",
    "test:reading-endurance": "NIR_PW_SUITE=reading-endurance playwright test",
    "test:reading-modes": "NIR_PW_SUITE=reading-modes playwright test",
    "test:storage": "NIR_PW_SUITE=storage playwright test",
    "test:audio-replacement": "NIR_PW_SUITE=audio-replacement playwright test",
    "test:realtime-pcm": "NIR_PW_SUITE=realtime-pcm playwright test",
    "test:livenovel-features": "NIR_PW_SUITE=livenovel-features playwright test",
    "test:performance:hardware": "node scripts/run-performance.mjs hardware",
    "test:performance:smoke": "node scripts/run-performance.mjs smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "license": "LGPL-3.0-or-later"
}
